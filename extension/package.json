{
  "name": "dubtitles-extension",
  "version": "1.0.0",
  "private": true,
  "description": "Chrome MV3 extension — Ukrainian subtitles and voice-over for online video courses",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build-manifest.ts && vite build --watch --mode development",
    "build": "node scripts/build-manifest.ts && vite build",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@lucide/vue": "^1.28.0",
    "@vueuse/core": "^14.4.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "reka-ui": "^2.10.1",
    "tailwind-merge": "^3.6.0",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.2.5",
    "@types/node": "^26.1.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "esbuild": "^0.28.1",
    "shadcn-vue": "^2.8.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vite": "^8.2.0",
    "vue-tsc": "^3.3.9"
  }
}
