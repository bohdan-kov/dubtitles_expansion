{
  "manifest_version": 3,
  "name": "Dubtitles",
  "version": "1.0.0",
  "description": "Ukrainian subtitles and voice-over for online video courses",
  "icons": {
    "16": "icons/dark/icon16.png",
    "32": "icons/dark/icon32.png",
    "48": "icons/dark/icon48.png",
    "128": "icons/dark/icon128.png"
  },
  "permissions": [
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "*://*.skilljar.com/*",
    "*://assets-jpcust.jwpsrv.com/*",
    "*://frontendmasters.com/*",
    "*://captions.frontendmasters.com/*",
    "*://*.master.dev/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.skilljar.com/*",
        "*://frontendmasters.com/*",
        "*://master.dev/*",
        "*://*.master.dev/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://frontendmasters.com/*",
        "*://master.dev/*",
        "*://*.master.dev/*"
      ],
      "js": [
        "inject.js"
      ],
      "world": "MAIN",
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Dubtitles",
    "default_icon": {
      "16": "icons/dark/icon16.png",
      "32": "icons/dark/icon32.png",
      "48": "icons/dark/icon48.png",
      "128": "icons/dark/icon128.png"
    }
  }
}
